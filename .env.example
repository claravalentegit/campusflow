# CampusFlow server settings. These stay on the server and are never sent to the browser.
# Copy to .env and fill in what you need. Nothing here is required for students to connect
# with an access token from the Connect Canvas page.

# Port for the server (Vite proxies /api to it in development).
PORT=8787

# Public address of this server. Used to build the OAuth redirect URL.
# PUBLIC_URL=https://campusflow.example.edu

# ——— "Sign in with Canvas" (OAuth) ———
# Needs a Developer Key from your school's Canvas admin (Admin > Developer Keys > + API Key)
# with the redirect URI set to  <PUBLIC_URL>/api/auth/oauth/callback
# CANVAS_OAUTH_BASE_URL=https://canvas.myschool.edu
# CANVAS_CLIENT_ID=
# CANVAS_CLIENT_SECRET=

# ——— Optional hardening ———
# Only allow these Canvas hosts for token sign-in (comma-separated, *.wildcards allowed).
# CANVAS_ALLOWED_HOSTS=*.instructure.com,canvas.myschool.edu
# Secret used to encrypt stored sessions. If unset, a random key is created in DATA_DIR.
# SESSION_SECRET=
# Where encrypted sessions are stored (default: .data).
# DATA_DIR=.data
# Always mark cookies Secure (set this when serving over https behind a proxy).
# COOKIE_SECURE=1

# ——— Single-user shortcut (optional) ———
# Instead of signing in through the app, the server can use one fixed token for everyone.
# Only for running CampusFlow just for yourself on your own machine.
# CANVAS_BASE_URL=https://canvas.myschool.edu
# CANVAS_ACCESS_TOKEN=
